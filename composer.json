{
  "name": "icanboogie/bind-event",
  "type": "library",
  "description": "Binds icanboogie/event to ICanBoogie",
  "version": "7.0",
  "keywords": [
    "event",
    "icanboogie"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/bind-event/issues",
    "source": "https://github.com/ICanBoogie/bind-event"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "icanboogie/autoconfig": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "icanboogie/icanboogie": "^7.0",
    "icanboogie/event": "^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\Binding\\Event\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\Binding\\Event\\": "tests/src"
    }
  },
  "extra": {
    "icanboogie": {
      "config-path": "config",
      "config-constructor": {
        "ICanBoogie\\Event\\Config": "ICanBoogie\\Binding\\Event\\ConfigBuilder"
      }
    }
  }
}
